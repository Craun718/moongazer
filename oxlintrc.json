{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "import"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {},
  "ignorePatterns": ["dist/", "node_modules/", "coverage/"]
}
